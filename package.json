{
  "name": "@chunge16/vitepress-blogs-theme",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "description": "A VitePress blog theme with authors, tags, archives, and a built-in setup wizard",
  "version": "1.0.0",
  "main": "src/theme/index.js",
  "bin": {
    "vitepress-blog-init": "./src/cli/index.js"
  },
  "scripts": {
    "test": "pnpm lint && pnpm test:unit && pnpm docs:build",
    "test:unit": "node --test test/**/*.test.js",
    "release": "changelogen --release --push && pnpm publish --access public --no-git-checks",
    "release:minor": "changelogen --release --minor --push && pnpm publish --access public --no-git-checks",
    "release:major": "changelogen --release --major --push && pnpm publish --access public --no-git-checks",
    "release:patch": "changelogen --release --patch --push && pnpm publish --access public --no-git-checks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "commit": "git add -A && czg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:eslint": "pnpm lint:fix",
    "prepare": "husky"
  },
  "author": "chunge16 (https://github.com/chunge16)",
  "license": "MIT",
  "homepage": "https://chunge16.github.io/vitepress-blogs-theme/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunge16/vitepress-blogs-theme.git"
  },
  "keywords": [
    "vite",
    "vue",
    "vitepress",
    "theme",
    "blog",
    "markdown",
    "ssg",
    "static-site-generator"
  ],
  "exports": {
    ".": "./src/theme/index.js",
    "./config": "./src/config/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "changelogen": "^0.6.2",
    "cz-git": "^1.13.1",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@giscus/vue": "^3.1.1",
    "@iconify-json/carbon": "^1.2.22",
    "@iconify-json/logos": "^1.2.11",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "date-fns": "^4.4.0",
    "picocolors": "^1.1.1",
    "tailwindcss": "^4.3.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.35"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{cjs,js,ts,vue}": [
      "npm run lint:eslint"
    ]
  }
}
